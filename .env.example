# ==============================================================================
# Todo Summary Assistant - Master Environment Configuration Template
# ==============================================================================
# Copy this file to .env before running:
# cp .env.example .env
# NOTE: Never commit your actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (MySQL / AWS RDS)
# ------------------------------------------------------------------------------
# Local Docker Compose: jdbc:mysql://mysql:3306/todo_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Bare Metal Local:     jdbc:mysql://localhost:3306/todo_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# AWS RDS Production:  jdbc:mysql://<rds-endpoint>:3306/todo_db?createDatabaseIfNotExist=true&useSSL=true&serverTimezone=UTC
DB_URL=jdbc:mysql://mysql:3306/todo_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=todo_user
DB_PASSWORD=SecurePassword123!
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# MySQL Container Initialization (Used only by docker-compose)
MYSQL_ROOT_PASSWORD=RootSecurePassword123!
MYSQL_DATABASE=todo_db
MYSQL_USER=todo_user
MYSQL_PASSWORD=SecurePassword123!

# ------------------------------------------------------------------------------
# 2. Backend Service Settings
# ------------------------------------------------------------------------------
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost

# External Integrations (Mandatory for Summarize & Slack notifications)
# Obtain Cohere API key from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# Obtain Slack Incoming Webhook from: https://api.slack.com/apps
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ------------------------------------------------------------------------------
# 3. Frontend Settings
# ------------------------------------------------------------------------------
# In Docker / Nginx reverse proxy environment, relative path '/api/todos' is recommended.
# For standalone local React development, use 'http://localhost:8080/api/todos'.
REACT_APP_API_BASE_URL=/api/todos

# ------------------------------------------------------------------------------
# 4. Monitoring (Prometheus & Grafana)
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001